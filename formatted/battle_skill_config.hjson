  {
    id: 11560201
    name: インパクトボンバー
    skill_group_id: 115602
    level: 1
    type: 1
    skill_priority: 10
    cd_type: 1
    cd_time: 300
    start_cd_time: 120
    trigger_type: 6
    trigger_target: 1
    trigger_parameter: "1"
    target_select_ai: 1
    action_id: 400
    is_form_action: 1
    skin_name: battle_skill_config-511560201
    buff_id_self: 4156:1
    description:
      '''
      自身の前方5ヤードの地点に手榴弾を投擲し、半径2.5ヤード内の敵に2倍のダメージを与える。
      また、このユニットの位置する場所によって、この攻撃を受けた敵をそれぞれ異なる方向へ3ヤードノックバックさせる。
      中段:上段または下段にノックバックさせる。
      上段/下段:中段にノックバックさせる。
      ノックバック効果は、攻撃中またはスキル発動中の敵には無効となる。(「SAFチップ」装備時、手榴弾のダメージが100%上昇し、敵をノックバックさせた後、さらに3秒間眩暈効果が持続する。)
      '''
    lvup_description: CT:10秒,ダメージ倍率:2倍
    code: SAF
    train_coin_type: 1
    is_switch: 1
    is_cdr: 1
    skill_lv_call: 1
    special_buff_trigger: "2"
  }

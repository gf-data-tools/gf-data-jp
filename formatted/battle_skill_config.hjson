  {
    id: 12010601
    name: デミウルゴスの啓示
    skill_group_id: 120106
    level: 1
    type: 1
    skill_priority: 10
    cd_type: 1
    cd_time: 240
    start_cd_time: 180
    trigger_type: 1
    trigger_target: 1
    target_select_ai: 1
    action_id: 400
    is_form_action: 1
    skin_name: battle_skill_config-512010601
    buff_id_self: 120106:1
    description:
      '''
      戦闘開始時、特殊弾を3発ストックする。
      スキル発動時、弾丸を1発消費し、1秒かけて照準を合わせ2.5倍のダメージを目標に与える。なお、最後の1発はダメージが倍になり、目標の火力を3秒間、10%低下させる。
      また、同一ステージ内で、勝利するたび、スキルで与えるダメージが5%上昇する。この効果は最大3重まで累積可能。(「Barrett QDL」装備時、特殊弾は非エリートユニットに対し会心が発生するようになる)
      '''
    lvup_description: ダメージ倍率:2.5倍,敵火力:-10%,低下効果持続時間:3秒,スキルダメージ:+5%
    code: M82A1
    train_coin_type: 1
    daynight_only: 1
    interrupt_type: 2
    is_switch: 1
    is_cdr: 1
    skill_lv_call: 1
    special_buff_trigger: "2"
  }

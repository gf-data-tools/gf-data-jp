    skin_name: battle_skill_config-511340101
    buff_id_self: 101:1000003956,580:1000003957,1000:1
    description:
      '''
      3秒間、自身の一部ステータスを上昇させる
      ステータス上昇効果は、スキル発動時に存在する敵グループの数に応じ、累積する
      火力上昇効果：火力+25%(最大3)/回避上昇効果：回避+12%(最大6)
      敵グループ数が1組のみの場合：火力上昇効果を+3
      敵グループ数が1組以上の場合：敵グループが1組増えるごとに、回避上昇効果を+1、火力上昇効果を-1
      '''
    lvup_description: CT:10秒,回避:+12%,火力:+25%,持続時間:3秒
    data_pool_1: "90"
    data_pool_2: "125,112"
    code: dodgeBuffSelf
    train_coin_type: 1
    daynight_only: 1
    is_switch: 1
    is_cdr: 1
    skill_lv_call: 1
    special_buff_trigger: "2"
  }

    skin_name: battle_skill_config-574010501
    buff_id_target: 9433:1
    buff_id_self: 9430:1,943301:1
    description:
      '''
      戦闘開始後、もし場に存在する銃種が2種類以下の場合、敵のボス以外のすべてのユニットに、脆弱状態を付与する。
      脆弱状態:会心ダメージを受けた時、追加で現在のHPの2%分のシールド無視ダメージを受ける。（最大1000ダメージまで）
      味方全体が100回会心ダメージを与える度に、味方全体の火力を1%上昇させる。火力上昇効果は戦闘終了まで持続し、最大3回まで重ね掛けできる。
      '''
    lvup_description: ダメージ倍率:2%,火力:+1%
    code: pxs_2
    train_coin_type: 1
    is_switch: 1
    is_cdr: 1
    skill_lv_call: 2
    special_buff_trigger: "2"
  }

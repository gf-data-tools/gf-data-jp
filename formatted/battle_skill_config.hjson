  {
    id: 100362001
    name: 沸き立つ殺意
    skill_group_id: 1003620
    level: 1
    type: 1
    skill_priority: 10
    cd_type: 1
    cd_time: 300
    start_cd_time: 120
    trigger_type: 1
    trigger_target: 1
    target_select_ai: 2
    is_form_action: 1
    buff_id_target: 9680:1000009560,9681:1000009560,9682:1000009560,9683:1000009560
    buff_id_self: 9684:1,9685:1000009528,9686:1000009529,9687:1000009530,9688:1000009531,1032:1000009561
    description:
      '''
      パッシブ:敵が1体撃破される度に、自身は増幅効果（火力、命中、回避が10%上昇する）を1つ獲得する。最大5つまで、戦闘終了まで持続。
      アクティブ:3秒間、味方全体に増幅効果を付与する。そして自身の増幅効果累計数によるすべての特殊効果を1回発動する。
      自身の増幅効果が累計2つの時、追加で自身の火力と命中を5秒間50%上昇させる。
      自身の増幅効果が累計3つの時、追加で最大HP5%分のシールドと被ダメージ5%軽減の効果を50秒間獲得する。
      自身の増幅効果が4つの時、5秒間、自身によるダメージは必ず会心し、シールドを無視する。
      自身の増幅効果が累計5つの時、5秒間ダミーを失う攻撃を1度だけ無効化する。
      （「登山用カラビナ」装備時、戦闘に勝利した回数に応じて、次の戦闘開始時増幅効果を1つ獲得する。最大3つまで）
      '''
    lvup_description: CT:10秒,全体増幅持続時間:3秒
    data_pool_1: "90"
    code: hecateskill
    train_coin_type: 1
    daynight_only: 1
    is_switch: 1
    passive_name: battle_skill_config-500362001
    is_cdr: 1
    skill_lv_call: 1
    special_buff_trigger: "2"
  }

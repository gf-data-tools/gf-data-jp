    start_cd_time: 180
    trigger_type: 1
    trigger_target: 1
    target_select_ai: 1
    action_id: 400
    buff_id_self: 9929:1
    description:
      '''
      パッシブ:自身にデバフ効果が付与された場合、攻撃は必ず命中する。戦闘開始後、射速デバフ効果を付与された場合、射速の減速速度が大きければ大きいほど与ダメージが大きくなり、最大で1000%まで上昇する。
      アクティブ:敵全体に付与されている被ダメージ減少効果と被ダメージ効果をそれぞれ1回解除する。その後、編成に応じて榴弾を発射し、半径2.5内にいる敵に2倍のダメージを与える。
      '''
    lvup_description: CT:20秒,手榴弾倍率:2倍
    code: EF88Skill
    train_coin_type: 1
    target_lost: 2
    daynight_only: 1
    interrupt_type: 2
    is_switch: 1
    passive_name: battle_skill_config-500860101
    is_cdr: 1
    skill_lv_call: 1
    special_buff_trigger: "2"
  }

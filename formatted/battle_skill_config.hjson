    name: 用意周到
    skill_group_id: 112901
    level: 1
    type: 1
    skill_priority: 11
    cd_type: 1
    cd_time: 165
    start_cd_time: 90
    trigger_type: 1
    trigger_target: 1
    target_select_ai: 1
    action_id: 400
    is_form_action: 1
    skin_name: battle_skill_config-511290101
    buff_id_self: 3133:1,10002:1
    description:
      '''
      アクティブ:スキルタップで予備弾倉射撃に切り替えが可能。
      攻撃するたび、予備弾倉から弾薬を1発消耗し、5秒間、自身の与えるダメージを10%上昇させ、命中を25%低下させる。(命中低下効果は最大10重まで累積する)
      予備弾倉使用前に、現在の弾薬は優先して使用され、再度スキルタップを行うことで、予備弾倉射撃モードを終了する。
      パッシブ:戦闘開始時、予備弾倉に弾薬を30発追加する。
      リロード時間を除く、3秒ごとに1発ずつ予備弾倉に弾薬を追加する。
      '''
    lvup_description: 火力:+20％,命中:-20%
    code: M1895MGs
    train_coin_type: 1
    is_switch: 1
    skill_lv_call: 1
    special_buff_trigger: "2"
  }

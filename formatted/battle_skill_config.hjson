  {
    id: 11750101
    name: ダンス・ウィズ・ミー
    skill_group_id: 117501
    level: 1
    type: 4
    skill_priority: 10
    cd_type: 1
    trigger_id: "117501,11750101"
    trigger_type: 1
    trigger_target: 1
    target_select_ai: 1
    is_form_action: 1
    skin_name: battle_skill_config-511750101
    buff_id_target: 4501:1,1201:1
    description:
      '''
      部隊に3名及び3名以上のアサルトライフルを編成した際、自身の火力を10%上昇させる。

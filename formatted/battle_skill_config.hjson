  {
    id: 75052801
    name: パラディンの心
    skill_group_id: 750528
    level: 1
    type: 1
    skill_priority: 2
    cd_type: 1
    cd_time: 600
    start_cd_time: 60
    trigger_type: 1
    target_select_ai: 1
    action_id: 400
    is_form_action: 1
    skin_name: battle_skill_config-575052801
    buff_id_self: 8458:1000004754,8457:1,8466:1,8522:1000004754,8523:1000004780
    description:
      '''
      パッシブ:戦闘開始時、味方の人数が敵より少ない場合、騎士精神を50ポイント獲得する。攻撃を行う度に、騎士精神を1ポイント獲得する。騎士精神1ポイントごとに、自身の火力と破甲を1上昇させる。（上限100ポイント）
      アクティブ:優先的に敵の高脅威度ユニットを攻撃する。6秒間、目標に対して3回破甲値から溢れた3%のダメージを与える。騎士精神が最大になっている場合、スキル発動期間中の攻撃は必中となり、さらに追加で自身の会心ダメージを10%上昇させる。
      自身が隊長として設定されている場合、スキル発動時、追加で自身及び自身の陣形効果マスにいる味方マシンガンとショットガン人形のデバフを無効化する。無効化したデバフの数1つにつき、騎士精神を2ポイント獲得する。
      '''
    lvup_description: CT:20秒,破甲値から溢れたダメージ:3%,持続時間:6秒
    data_pool_1: "180"
    data_pool_2: "110"
    code: M240L
    train_coin_type: 1
    daynight_only: 1
    is_switch: 1
    is_cdr: 1
    skill_lv_call: 1
    special_buff_trigger: "2"
  }

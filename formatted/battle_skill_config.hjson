    skin_name: battle_skill_config-591103101
    buff_id_self: 397701:1
    buff_delay: 123
    description:
      '''
      敵のHPが多い順に3体のユニットに2回突撃を行う。1回目の突撃で1倍の必中ダメージを与え、ウェイトマークを付与する。
      2回目の突撃では2倍の必中ダメージを与え、その後、目標周囲の半径2ヤード内の敵に、ウェイトマーク1つにつき、シールドを無視した0.3倍の必中<color=#db3d3d>爆発ダメージ</color>を与える。
      このスキルによる攻撃は敵の防御値を無視するが、会心が発生しない。
      '''
    lvup_description: CT:15秒,1回目ダメージ:1倍,2回目ダメージ:2倍,マークによるダメージ:0.3倍
    data_pool_1: *3720,100,200
    data_pool_2: *3721,*3722
    code: Gager1
    train_coin_type: 4
    is_switch: 1
    is_cdr: 1
    skill_lv_call: 1
    special_buff_trigger: "2"
  }

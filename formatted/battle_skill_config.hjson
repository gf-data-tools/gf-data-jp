    buff_id_target: 7409:1,740904:1,740905:1
    buff_id_self: 740907:1
    buff_delay: 41
    description:
      '''
      パッシブ:アデリンの与えるダメージは全て目標のダミー全員に分けて与えられる。
      敵ユニットにブラックマークとホワイトマークの両方が付与されている場合、場のアデリンの起爆マークによって(上記マークは両方除去される)、防御値を無視した1倍の必中<color=#db3d3d>爆破ダメージ</color>が与えられる。
      アクティブ:4秒間、敵のブラックマークが起爆により除去されなくなり、敵全体の命中と回避が10%低下する。
      アクティブ発動中は敵のダミー単体を優先して攻撃し、1秒毎に照準を合わせ、2倍の必中ダメージを与える(この攻撃には敵の防御値が適用され、一定の確率で会心が発動する)。
      '''
    lvup_description: CT:20秒,爆破ダメージ:1倍,敵ステータス:-10%,持続時間:4秒,狙撃ダメージ:2倍
    data_pool_1: "120"
    data_pool_2: "90"
    code: NytoB1
    train_coin_type: 4
    is_cdr: 1
    skill_lv_call: 1
    special_buff_trigger: "2"
  }
